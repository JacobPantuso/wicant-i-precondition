# V300 (ESP32-C3, 4MB flash) target-specific deltas.
CONFIG_ESPTOOLPY_NO_STUB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="wican_partitions_table.csv"

# Parked BLE standby (experimental branch, standby_platform.c). Power
# management is compiled in but applied only while parked; the rest of the
# time the CPU stays at its fixed default frequency. Modem sleep uses the
# main crystal as the low-power clock (a 32 kHz crystal is not assumed), which
# must stay powered in light sleep for BLE timing.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
